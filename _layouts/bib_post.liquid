<div id="{{ entry.key }}" class="math-ref">
  {% if entry.doi %}
    {% assign doi_url = "https://doi.org/" | append: entry.doi %}
    {{ reference | remove: doi_url }}
    <a href="{{ doi_url }}">[doi]</a>
  {% else %}
    {{ reference }}
    {% if entry.html %}<a href="{{ entry.html }}">[link]</a>{% endif %}
  {% endif %}
  {% if entry.arxiv %}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}">[arXiv]</a>
  {% endif %}
</div>