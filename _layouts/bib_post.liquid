<div id="{{ entry.key }}" class="math-ref">
  {{ reference }}
  {% if entry.doi %}
    <a href="https://doi.org/{{ entry.doi }}">[doi]</a>
  {% elsif entry.html %}
    <a href="{{ entry.html }}">[link]</a>
  {% endif %}
  {% if entry.arxiv %}
    <a href="https://arxiv.org/abs/{{ entry.arxiv }}">[arXiv]</a>
  {% endif %}
</div>