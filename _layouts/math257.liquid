---
layout: page
---

<style>
  /*
   * Math 257 pages need more horizontal space for interactive applets.
   * This CSS is only emitted on pages using layout: math257.
   */
  main.container,
  .container[role="main"] {
    max-width: 1200px !important;
    width: 94% !important;
  }

  .math257-text,
  .iclicker-question,
  .groupwork-question {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  /* =========================================================
     Activity boxes: shared styling
     ========================================================= */

  .iclicker-question {
    --activity-color: #ff9500;
    --activity-rgb: 255, 149, 0;
  }

  .groupwork-question {
    --activity-color: #9b59b6;
    --activity-rgb: 155, 89, 182;
  }

  .iclicker-question,
  .groupwork-question {
    max-width: 760px;
    margin: 1.5rem auto;
    padding: 1.1rem 1.3rem;
    background: rgba(var(--activity-rgb), 0.10);
    border: 2px solid var(--activity-color);
    border-radius: 0.85rem;
    box-shadow: 0 0 10px rgba(var(--activity-rgb), 0.45), 0 0 28px rgba(var(--activity-rgb), 0.22);
    cursor: pointer;
  }

  /* Automatic labels at the top of the boxes */
  .iclicker-question::before,
  .groupwork-question::before {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--activity-color);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .iclicker-question::before {
    content: "iClicker Question";
  }

  .groupwork-question::before {
    content: "Group Work";
  }

  /* Avoid unwanted extra space at the bottom */
  .iclicker-question > :last-child,
  .groupwork-question > :last-child {
    margin-bottom: 0;
  }

  /* =========================================================
     Optional images inside activity boxes
     ========================================================= */

  .iclicker-question img.iclicker-image,
  .groupwork-question img.groupwork-image {
    float: right;
    width: min(38%, 280px);
    height: auto;
    margin: 0.1rem 0 0.8rem 1rem;
    border-radius: 0.6rem;
  }

  /* Clear floated images properly */
  .iclicker-question::after,
  .groupwork-question::after {
    content: "";
    display: block;
    clear: both;
  }

  /* =========================================================
     Small fullscreen hint
     ========================================================= */

  .activity-fullscreen-hint {
    margin-top: 0.75rem;
    color: var(--global-text-color-light, #777);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* =========================================================
     Fullscreen presentation mode
     ========================================================= */

  .iclicker-question:fullscreen,
  .groupwork-question:fullscreen {
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100vh;
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2.5rem);
    overflow: auto;
    background: var(--global-bg-color, #fff);
    border: 8px solid var(--activity-color);
    border-radius: 0;
    box-shadow: inset 0 0 35px rgba(var(--activity-rgb), 0.28);
    font-size: inherit;
    line-height: 1.4;
    cursor: default;
  }

  /* Background around the fullscreen element */
  .iclicker-question::backdrop,
  .groupwork-question::backdrop {
    background: var(--global-bg-color, #fff);
  }

  /* Keep the activity label close to its normal size in fullscreen mode */
  .iclicker-question:fullscreen::before,
  .groupwork-question:fullscreen::before {
    margin-bottom: 0.8rem;
    font-size: 0.9rem;
  }

  /* Hide the "click to fullscreen" hint once fullscreen */
  .iclicker-question:fullscreen .activity-fullscreen-hint,
  .groupwork-question:fullscreen .activity-fullscreen-hint {
    display: none;
  }

  /* Keep images from taking over the fullscreen view */
  .iclicker-question:fullscreen img.iclicker-image,
  .groupwork-question:fullscreen img.groupwork-image {
    float: right;
    width: min(35%, 400px);
    max-width: 400px;
    max-height: 55vh;
    object-fit: contain;
    margin: 0.1rem 0 1rem 1.5rem;
  }

  /* =========================================================
     Mobile behavior
     ========================================================= */

  @media (max-width: 700px) {
    .iclicker-question,
    .groupwork-question {
      max-width: 100%;
    }

    .iclicker-question img.iclicker-image,
    .groupwork-question img.groupwork-image {
      float: none;
      display: block;
      width: 100%;
      max-width: 420px;
      margin: 0 auto 1rem;
    }

    .iclicker-question:fullscreen img.iclicker-image,
    .groupwork-question:fullscreen img.groupwork-image {
      float: none;
      display: block;
      width: 100%;
      max-width: 420px;
      max-height: 40vh;
      margin: 0 auto 1rem;
    }
  }

  /*
   * Keep sensible margins on small screens.
   */
  @media (max-width: 576px) {
    main.container,
    .container[role="main"] {
      width: 100% !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  .math257-week-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--global-divider-color, #ddd);
  }

  .math257-week-nav a {
    text-decoration: none;
  }

  .math257-week-nav__previous {
    justify-self: start;
  }

  .math257-week-nav__home {
    justify-self: center;
    text-align: center;
  }

  .math257-week-nav__next {
    justify-self: end;
    text-align: right;
  }

  .math257-week-nav__label {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--global-text-color-light, #666);
    font-size: 0.78rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .math257-week-nav__title {
    font-weight: 600;
  }

  /*
   * On narrow screens, stack the navigation links.
   */
  @media (max-width: 576px) {
    .math257-week-nav {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .math257-week-nav__previous,
    .math257-week-nav__home,
    .math257-week-nav__next {
      justify-self: stretch;
      text-align: left;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  document
    .querySelectorAll(".iclicker-question, .groupwork-question")
    .forEach((box) => {
      const hint = document.createElement("div");

      hint.className =
        "activity-fullscreen-hint";

      hint.textContent =
        "Click to present fullscreen · Esc to return";

      box.appendChild(hint);

      box.addEventListener(
        "click",
        (event) => {
          if (
            event.target.closest(
              "a, button, input, select, textarea"
            )
          ) {
            return;
          }

          if (
            !document.fullscreenElement
          ) {
            box.requestFullscreen?.();
          }
        }
      );
    });
});
</script>

<div class="math257-page">
  {{ content }}

  {% assign course_home = page.course_home | default: '/math257/' %}

  <nav class="math257-week-nav" aria-label="Math 257 week navigation">

    <div class="math257-week-nav__previous">
      {% if page.previous_week %}
        {% assign previous_url = '/math257/week' | append: page.previous_week | append: '/' %}

        <a href="{{ previous_url | relative_url }}">
          <span class="math257-week-nav__label">Previous</span>
          <span class="math257-week-nav__title">
            ← Week {{ page.previous_week }}
          </span>
        </a>
      {% endif %}
    </div>

    <div class="math257-week-nav__home">
      <a href="{{ course_home | relative_url }}">
        <span class="math257-week-nav__label">Math 257</span>
        <span class="math257-week-nav__title">
          Course home
        </span>
      </a>
    </div>

    <div class="math257-week-nav__next">
      {% if page.next_week %}
        {% assign next_url = '/math257/week' | append: page.next_week | append: '/' %}

        <a href="{{ next_url | relative_url }}">
          <span class="math257-week-nav__label">Next</span>
          <span class="math257-week-nav__title">
            Week {{ page.next_week }} →
          </span>
        </a>
      {% endif %}
    </div>

  </nav>
</div>

<script
  type="module"
  src="{{ '/assets/js/math257/math257.js' | relative_url }}">
</script>
