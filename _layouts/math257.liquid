---
layout: page
---

{% assign math257_header_mode = page.math257_header | default: 'date' %}

<style>
  /* =========================================================
     Teaching header: one-line date plus al-folio's progress bar
     Set math257_header: progress-only to keep only the progress bar.
     ========================================================= */

  /* Keep the header visible because it also contains the progress bar. */
  body > header {
    display: block !important;
  }

  {% if math257_header_mode == 'progress-only' %}
  body > header #navbar {
    display: none !important;
  }

  body,
  body.fixed-top-nav {
    padding-top: 0 !important;
  }

  body > header #progress {
    top: 0 !important;
  }
  {% else %}
  body > header #navbar {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box;
    height: 3rem !important;
    min-height: 3rem !important;
    padding: 0 1rem !important;
    overflow: hidden;
  }

  /* The date is a direct child of #navbar, outside the original menu. */
  body > header #navbar > :not(.math257-header-date) {
    display: none !important;
  }

  body > header #navbar > .math257-header-date {
    display: block !important;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding: 0;
    color: var(--global-text-color, #222);
    font-size: clamp(0.75rem, 2.8vw, 0.95rem);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  {% endif %}

  /* Keep a modest gap above the lesson. */
  main.container,
  .container[role="main"] {
    margin-top: 1.5rem !important;
  }

  /*
   * Math 257 pages need more horizontal space for interactive applets.
   * This CSS is only emitted on pages using layout: math257.
   */
  main.container,
  .container[role="main"] {
    max-width: 1200px !important;
    width: 94% !important;
  }

  .math257-text,
  .math257-activity {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  /* =========================================================
     Activity boxes: shared styling for every category
     Labels and colors are defined once in ACTIVITY_TYPES below.
     JavaScript adds .math257-activity to each recognized box.
     ========================================================= */

  .math257-activity {
    max-width: 760px;
    margin: 1.5rem auto;
    padding: 1.1rem 1.3rem;
    background: rgba(var(--activity-rgb), 0.10);
    border: 2px solid var(--activity-color);
    border-radius: 0.85rem;
    box-shadow: 0 0 10px rgba(var(--activity-rgb), 0.45), 0 0 28px rgba(var(--activity-rgb), 0.22);
    cursor: pointer;
  }

  /* The same label is used on the page and in the fullscreen toolbar. */
  .math257-activity::before {
    content: attr(data-activity-label);
    display: block;
    margin-bottom: 0.7rem;
    color: var(--activity-color);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .math257-activity > :last-child {
    margin-bottom: 0;
  }

  /* This wrapper keeps the content separate from its fullscreen controls. */
  .activity-fullscreen-content {
    display: flow-root;
  }

  .activity-fullscreen-content > :last-child {
    margin-bottom: 0;
  }

  /* =========================================================
     Optional images: use class="activity-image" for any category.
     Existing category-specific image classes are recognized by JavaScript.
     ========================================================= */

  .math257-activity img.activity-image {
    float: right;
    width: min(38%, 280px);
    height: auto;
    margin: 0.1rem 0 0.8rem 1rem;
    border-radius: 0.6rem;
  }

  .math257-activity::after {
    content: "";
    display: block;
    clear: both;
  }

  /* =========================================================
     Small fullscreen hint
     ========================================================= */

  .activity-fullscreen-hint {
    margin-top: 0.75rem;
    color: var(--global-text-color-light, #777);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* =========================================================
     Fullscreen presentation mode and text-size controls
     ========================================================= */

  .activity-fullscreen-toolbar {
    display: none;
  }

  .math257-activity:fullscreen {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2.5rem);
    padding-top: max(clamp(1rem, 2.5vw, 2.5rem), env(safe-area-inset-top));
    padding-right: max(clamp(1rem, 2.5vw, 2.5rem), env(safe-area-inset-right));
    padding-bottom: max(clamp(1rem, 2.5vw, 2.5rem), env(safe-area-inset-bottom));
    padding-left: max(clamp(1rem, 2.5vw, 2.5rem), env(safe-area-inset-left));
    overflow: hidden;
    background: var(--global-bg-color, #fff);
    border: 8px solid var(--activity-color);
    border-radius: 0;
    box-shadow: inset 0 0 35px rgba(var(--activity-rgb), 0.28);
    font-size: inherit;
    line-height: 1.4;
    cursor: default;
  }

  .math257-activity::backdrop {
    background: var(--global-bg-color, #fff);
  }

  /* The toolbar supplies the label while fullscreen. */
  .math257-activity:fullscreen::before,
  .math257-activity:fullscreen::after,
  .math257-activity:fullscreen .activity-fullscreen-hint {
    display: none;
  }

  .math257-activity:fullscreen > .activity-fullscreen-toolbar {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(var(--activity-rgb), 0.35);
    color: var(--global-text-color, #222);
    font-size: 1rem;
    line-height: 1.2;
  }

  .activity-fullscreen-label {
    color: var(--activity-color);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .activity-fullscreen-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-left: auto;
  }

  .activity-fullscreen-controls button {
    box-sizing: border-box;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--activity-color);
    border-radius: 0.45rem;
    background: rgba(var(--activity-rgb), 0.10);
    color: var(--global-text-color, #222);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
  }

  .activity-fullscreen-controls button:focus-visible,
  .math257-activity:focus-visible {
    outline: 3px solid var(--activity-color);
    outline-offset: 3px;
  }

  .activity-fullscreen-controls button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  @media (hover: hover) {
    .activity-fullscreen-controls button:hover:not(:disabled) {
      background: rgba(var(--activity-rgb), 0.22);
    }
  }

  .activity-font-size {
    min-width: 3.2rem;
    margin: 0;
    padding: 0;
    color: inherit;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /* Only the content scrolls; the controls always stay above it. */
  .math257-activity:fullscreen > .activity-fullscreen-content {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    padding: 0.25rem;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    overflow-wrap: break-word;
  }

  /* Preserve relative sizes, including headings or code styled in rem. */
  .math257-activity:fullscreen [data-activity-font-size] {
    font-size: calc(var(--activity-base-font-size) * var(--activity-font-scale, 1)) !important;
  }

  /* Images keep their existing size limits when the text is enlarged. */
  .math257-activity:fullscreen img.activity-image {
    float: right;
    width: min(35%, 400px);
    max-width: 400px;
    max-height: 55vh;
    object-fit: contain;
    margin: 0.1rem 0 1rem 1.5rem;
  }

  /* =========================================================
     Mobile behavior
     ========================================================= */

  @media (max-width: 700px) {
    .math257-activity {
      max-width: 100%;
    }

    .math257-activity img.activity-image {
      float: none;
      display: block;
      width: 100%;
      max-width: 420px;
      margin: 0 auto 1rem;
    }

    .math257-activity:fullscreen img.activity-image {
      float: none;
      display: block;
      width: 100%;
      max-width: 420px;
      max-height: 40vh;
      margin: 0 auto 1rem;
    }
  }

  /* Keep sensible margins on small screens. */
  @media (max-width: 576px) {
    main.container,
    .container[role="main"] {
      width: 100% !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  /* =========================================================
     Course footer
     ========================================================= */

  .math257-footer {
    max-width: 760px;
    margin: 3rem auto 0;
    color: var(--global-text-color-light, #666);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
  }

  .math257-footer a {
    color: inherit;
    text-decoration: underline;
  }

  /* =========================================================
     Week navigation
     ========================================================= */

  .math257-week-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--global-divider-color, #ddd);
  }

  .math257-week-nav a {
    text-decoration: none;
  }

  .math257-week-nav__previous {
    justify-self: start;
  }

  .math257-week-nav__home {
    justify-self: center;
    text-align: center;
  }

  .math257-week-nav__next {
    justify-self: end;
    text-align: right;
  }

  .math257-week-nav__label {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--global-text-color-light, #666);
    font-size: 0.78rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .math257-week-nav__title {
    font-weight: 600;
  }

  /* On narrow screens, stack the navigation links. */
  @media (max-width: 576px) {
    .math257-week-nav {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .math257-week-nav__previous,
    .math257-week-nav__home,
    .math257-week-nav__next {
      justify-self: stretch;
      text-align: left;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  {% unless math257_header_mode == 'progress-only' %}
  const navbar = document.querySelector("body > header #navbar");

  if (navbar) {
    // Remove a previous date element if this setup runs again.
    navbar.querySelectorAll(".math257-header-date").forEach((element) => {
      element.remove();
    });

    // Keep the original elements available to al-folio's scripts, but
    // hide and disable their entire container, not individual menu items.
    // Inline !important also overrides the theme's layered display rules.
    Array.from(navbar.children).forEach((element) => {
      element.hidden = true;
      element.setAttribute("inert", "");
      element.setAttribute("aria-hidden", "true");
      element.style.setProperty("display", "none", "important");
    });

    // Append directly to #navbar so the date cannot share a row with a menu.
    const dateElement = document.createElement("time");
    dateElement.className = "math257-header-date";
    navbar.appendChild(dateElement);

    const dateFormatter = new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });

    // Use the viewer's local date, not the date Jekyll built the site.
    const updateHeaderDate = () => {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");

      dateElement.dateTime = `${year}-${month}-${day}`;
      dateElement.textContent = dateFormatter.format(now);
    };

    updateHeaderDate();

    window.setInterval(updateHeaderDate, 60000);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) updateHeaderDate();
    });

    // Keep al-folio's existing progress element and let its script
    // remeasure the new, single-line navbar height.
    window.requestAnimationFrame(() => {
      window.dispatchEvent(new Event("resize"));
    });
  }
  {% endunless %}

  /* =========================================================
     Activity categories: edit only this list to add another type.
     Use a CSS class name without a leading dot and a six-digit hex color.
     RGB values, labels, shared styling, and controls are set automatically.
     Example additional entry:
     "worked-example": { label: "Worked Example", color: "#2563eb" },
     ========================================================= */
  const ACTIVITY_TYPES = {
    "iclicker-question": { label: "iClicker Question", color: "#ff9500" },
    "groupwork-question": { label: "Group Work", color: "#9b59b6" },
    "demonstration": { label: "Demonstration", color: "#009988" },
  };

  const hexToRgb = (hex) => {
    return hex.slice(1).match(/../g).map((pair) => parseInt(pair, 16)).join(", ");
  };

  // Skip an invalid entry without disabling the other categories.
  const activityTypes = Object.entries(ACTIVITY_TYPES).flatMap(([className, type]) => {
    const validClass = /^[a-z][a-z0-9_-]*$/i.test(className);
    const validLabel = typeof type?.label === "string" && type.label.trim().length > 0;
    const validColor = typeof type?.color === "string" && /^#[0-9a-f]{6}$/i.test(type.color);

    if (!validClass || !validLabel || !validColor) {
      console.warn("Skipping an invalid Math 257 activity category:", className);
      return [];
    }

    return [{ className, label: type.label, color: type.color, rgb: hexToRgb(type.color) }];
  });

  if (activityTypes.length === 0) return;
  const activitySelector = activityTypes.map((type) => `.${type.className}`).join(", ");

  const MIN_TEXT_SIZE = 60;
  const MAX_TEXT_SIZE = 250;
  const TEXT_SIZE_STEP = 10;
  const activityStates = new Map();
  let activeActivity = null;

  // Measure before fullscreen so 100% matches each element's normal size.
  // Leave math-renderer internals alone; they scale with their surrounding text.
  const captureTextSizes = (content) => {
    const excluded = "mjx-container, .MathJax, .MathJax_Display, .MathJax_SVG, .MathJax_SVG_Display, .MathJax_CHTML, .MathJax_CHTML_Display, .katex, svg, math, script, style";
    const elements = [content, ...content.querySelectorAll("*")].filter((element) => {
      return element instanceof HTMLElement && !element.closest(excluded);
    });
    const sizes = elements.map((element) => getComputedStyle(element).fontSize);

    elements.forEach((element, index) => {
      element.setAttribute("data-activity-font-size", "");
      element.style.setProperty("--activity-base-font-size", sizes[index]);
    });
  };

  document.querySelectorAll(activitySelector).forEach((box) => {
    if (box.dataset.fullscreenControlsReady) return;
    const type = activityTypes.find((entry) => box.classList.contains(entry.className));
    if (!type) return;

    box.dataset.fullscreenControlsReady = "true";
    box.dataset.activityLabel = type.label;
    box.classList.add("math257-activity");
    box.style.setProperty("--activity-color", type.color);
    box.style.setProperty("--activity-rgb", type.rgb);

    // Preserve image classes already used in existing week pages.
    box.querySelectorAll("img.iclicker-image, img.groupwork-image, img.demonstration-image").forEach((image) => {
      image.classList.add("activity-image");
    });

    const content = document.createElement("div");
    content.className = "activity-fullscreen-content";
    while (box.firstChild) content.appendChild(box.firstChild);

    const toolbar = document.createElement("div");
    toolbar.className = "activity-fullscreen-toolbar";
    toolbar.setAttribute("role", "group");
    toolbar.setAttribute("aria-label", "Fullscreen activity controls");

    const label = document.createElement("span");
    label.className = "activity-fullscreen-label";
    label.textContent = box.dataset.activityLabel;

    const controls = document.createElement("div");
    controls.className = "activity-fullscreen-controls";

    const makeButton = (text, description) => {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = text;
      button.title = description;
      button.setAttribute("aria-label", description);
      return button;
    };

    const smaller = makeButton("A−", "Decrease text size");
    const larger = makeButton("A+", "Increase text size");
    const reset = makeButton("Reset", "Reset text size to 100%");
    const exit = makeButton("Exit", "Exit fullscreen");
    const sizeLabel = document.createElement("output");
    sizeLabel.className = "activity-font-size";
    sizeLabel.setAttribute("aria-label", "Text size");
    sizeLabel.setAttribute("aria-live", "polite");
    sizeLabel.setAttribute("aria-atomic", "true");

    controls.append(smaller, sizeLabel, larger, reset, exit);
    toolbar.append(label, controls);

    const hint = document.createElement("div");
    hint.className = "activity-fullscreen-hint";
    hint.textContent = "Tap or click to present fullscreen · Exit or Esc to return";

    box.append(toolbar, content, hint);
    if (!box.hasAttribute("tabindex")) box.tabIndex = 0;

    // Each activity remembers its own size until the page is reloaded.
    const state = { box, content, larger, exit, percent: 100 };
    activityStates.set(box, state);

    const setTextSize = (percent) => {
      state.percent = Math.min(MAX_TEXT_SIZE, Math.max(MIN_TEXT_SIZE, percent));
      box.style.setProperty("--activity-font-scale", String(state.percent / 100));
      sizeLabel.value = `${state.percent}%`;
      smaller.disabled = state.percent === MIN_TEXT_SIZE;
      larger.disabled = state.percent === MAX_TEXT_SIZE;
      reset.disabled = state.percent === 100;
    };

    setTextSize(100);

    // Button taps must not reach the box's fullscreen click handler.
    controls.addEventListener("click", (event) => event.stopPropagation());
    smaller.addEventListener("click", () => setTextSize(state.percent - TEXT_SIZE_STEP));
    larger.addEventListener("click", () => setTextSize(state.percent + TEXT_SIZE_STEP));
    reset.addEventListener("click", () => setTextSize(100));

    exit.addEventListener("click", async () => {
      if (document.fullscreenElement !== box) return;
      try {
        await document.exitFullscreen();
      } catch (error) {
        console.warn("Could not exit fullscreen.", error);
      }
    });

    const enterFullscreen = async () => {
      if (document.fullscreenElement) return;
      if (!box.requestFullscreen) {
        hint.textContent = "Fullscreen is unavailable in this browser.";
        return;
      }

      captureTextSizes(content);
      try {
        await box.requestFullscreen();
      } catch (error) {
        hint.textContent = "Fullscreen could not open. Tap or click to try again.";
        console.warn("Could not enter fullscreen.", error);
      }
    };

    box.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest("a, button, input, select, textarea, summary, [contenteditable], .activity-fullscreen-toolbar")) return;
      enterFullscreen();
    });

    box.addEventListener("keydown", (event) => {
      if (event.target !== box || document.fullscreenElement) return;
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      enterFullscreen();
    });
  });

  // Also handle the browser's own fullscreen exit (Esc, Back, or its controls).
  document.addEventListener("fullscreenchange", () => {
    const nextActivity = activityStates.get(document.fullscreenElement) || null;

    if (activeActivity && activeActivity !== nextActivity) {
      activeActivity.content.scrollTop = 0;
      activeActivity.content.scrollLeft = 0;
      if (!nextActivity) activeActivity.box.focus({ preventScroll: true });
    }

    activeActivity = nextActivity;
    if (activeActivity) {
      activeActivity.content.scrollTop = 0;
      const focusTarget = activeActivity.larger.disabled ? activeActivity.exit : activeActivity.larger;
      focusTarget.focus({ preventScroll: true });
    }
  });
});
</script>

<div class="math257-page">
  {{ content }}

  <div class="math257-footer">
    This website has been designed with the assistance of ChatGPT (GPT-5.6 Sol and GPT-6 Astra Pro).<br/>
    The source code can be found at
    <a href="https://github.com/felixled/felixled.github.io">https://github.com/felixled/felixled.github.io</a>.<br/>
    [Please contact me](mailto:{{ site.data.socials.email | encode_email }}) with feedback or if you find any bugs!
  </div>

  {% assign course_home = page.course_home | default: '/math257/' %}

  <nav class="math257-week-nav" aria-label="Math 257 week navigation">

    <div class="math257-week-nav__previous">
      {% if page.previous_week %}
        {% assign previous_url = '/math257/week' | append: page.previous_week | append: '/' %}

        <a href="{{ previous_url | relative_url }}">
          <span class="math257-week-nav__label">Previous</span>
          <span class="math257-week-nav__title">
            ← Week {{ page.previous_week }}
          </span>
        </a>
      {% endif %}
    </div>

    <div class="math257-week-nav__home">
      <a href="{{ course_home | relative_url }}">
        <span class="math257-week-nav__label">Math 257</span>
        <span class="math257-week-nav__title">
          Course home
        </span>
      </a>
    </div>

    <div class="math257-week-nav__next">
      {% if page.next_week %}
        {% assign next_url = '/math257/week' | append: page.next_week | append: '/' %}

        <a href="{{ next_url | relative_url }}">
          <span class="math257-week-nav__label">Next</span>
          <span class="math257-week-nav__title">
            Week {{ page.next_week }} →
          </span>
        </a>
      {% endif %}
    </div>

  </nav>
</div>

<script
  type="module"
  src="{{ '/assets/js/math257/math257.js' | relative_url }}">
</script>
