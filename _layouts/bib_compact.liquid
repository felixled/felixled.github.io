<span class="title">{{ entry.title }}</span>.
   {{ entry.author }}.
   {% if entry.journal %}<em>{{ entry.journal }}</em>, {% endif %}{{ entry.year }}.
   {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
   {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">Journal</a>{% endif %}